{
  "name": "realestate-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "init:client": "tsx scripts/init-client.ts",
    "db:setup": "npm run db:migrate && npm run db:seed:essentials",
    "db:seed:essentials": "tsx --env-file=.env.local src/lib/db/seed-essentials.ts",
    "db:seed:demo": "tsx --env-file=.env.local src/lib/db/seed-demo.ts",
    "rates": "tsx --env-file=.env.local scripts/set-rate.ts",
    "doctor": "tsx --env-file=.env.local scripts/doctor.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.7.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.7.1",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
