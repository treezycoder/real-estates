DATABASE_URL=
# Which "client" this deployment serves. Keep "default" until you go multi-tenant.
TENANT_ID=


BETTER_AUTH_SECRET=       # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@gmail.com,another@gmail.com
UPLOADTHING_TOKEN=



NEXT_PUBLIC_SITE_URL=http://localhost:3000   # the real domain in production
RESEND_API_KEY=                              # optional; emails are skipped without it
EMAIL_FROM=                                  # e.g. "Agency <notifications@clientdomain.com>"
NOTIFY_EMAILS=                               # optional, comma-separated; defaults to siteConfig.contact.email
RATE_LIMIT_SALT=                             # optional; falls back to BETTER_AUTH_SECRET